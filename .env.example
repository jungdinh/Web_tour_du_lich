DATABASE_URL=postgresql://postgres:password@localhost:5432/tour_recommendation
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# AI Service
GEMINI_API_KEY=your-gemini-api-key
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=internal-api-key-for-web-service

# CORS
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cache TTL (seconds)
CACHE_TOUR_POPULAR_TTL=3600
CACHE_TOUR_DETAIL_TTL=1800
CACHE_SEARCH_TTL=900

# Crawler
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; TourRecommendationBot/1.0)
