# =========================================
# Project-wide .env.example (root)
# =========================================
# NOTE: Each service has its own .env file (web-fe/, web-be/, ai-service/, crawler/).
# This file is kept for documentation and quick copy of common variables.
#
# Default ports:
#   web-fe:      5174
#   web-be:      3000
#   ai-service:  8000
#   PostgreSQL:  5432

# ----------------------
# Database (shared)
# ----------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/tour_recommendation

# ----------------------
# web-be (Backend)
# ----------------------
# Local only. Railway injects PORT automatically in production.
PORT=3000
NODE_ENV=development

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# AI Service settings
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=internal-api-key-for-web-service

# CORS - must match web-fe port
FRONTEND_URL=http://localhost:5174
# Production can list exact Vercel production/preview origins separated by commas.
# Use origins only (for example https://tour-ai.vercel.app), without /api.
FRONTEND_URLS=http://localhost:5174
# Set to 1 when web-be runs behind Railway proxy.
TRUST_PROXY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cache TTL (seconds)
CACHE_TOUR_POPULAR_TTL=3600
CACHE_TOUR_DETAIL_TTL=1800
CACHE_SEARCH_TTL=900

# ----------------------
# ai-service
# ----------------------
GEMINI_API_KEY=your-gemini-api-key-here
# (Leave empty to use mock LLM)

# ----------------------
# crawler
# ----------------------
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; TourRecommendationBot/1.0)

# Admin seed (web-be)
ADMIN_EMAIL=admin123@gmail.com
ADMIN_PASSWORD=change-this-password
ADMIN_SYNC_PASSWORD=false

# ----------------------
# Booking & SePay QR payment (web-be)
# ----------------------
PAYMENT_EXPIRES_MINUTES=30
SEPAY_BANK_CODE=VCB
SEPAY_ACCOUNT_NUMBER=your-bank-account-number
SEPAY_ACCOUNT_NAME=YOUR ACCOUNT NAME
SEPAY_WEBHOOK_API_KEY=replace-with-sepay-webhook-key
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
# ----------------------
# Email verification (web-be)
# ----------------------
# Local: console. Railway production: resend.
EMAIL_PROVIDER=console
EMAIL_VERIFICATION_EXPIRES_MINUTES=10
EMAIL_VERIFICATION_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=
# onboarding@resend.dev is for testing with the Resend account email only.
# To email arbitrary users, replace it with an address on a verified domain.
MAIL_FROM=TourAI <onboarding@resend.dev>

# ----------------------
# Google Login (web-be)
# ----------------------
GOOGLE_CLIENT_ID=

# ----------------------
# Google Login (web-fe)
# ----------------------
VITE_GOOGLE_CLIENT_ID=
